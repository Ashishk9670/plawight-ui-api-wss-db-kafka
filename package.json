{
  "name": "playwright-ui-api-wss-db-kafka",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript framework: UI, REST, GraphQL, WebSocket, Kafka, DB, E2E",
  "scripts": {
    "aut:up": "docker compose -f docker/docker-compose.yml up -d --build --wait",
    "aut:down": "docker compose -f docker/docker-compose.yml down -v",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit && tsc --noEmit -p aut/tsconfig.json",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "dotenv": "^16.4.7",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  }
}
