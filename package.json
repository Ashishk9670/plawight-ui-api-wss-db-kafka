{
  "name": "playwright-ui-api-wss-db-kafka",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript framework: UI, REST, GraphQL, WebSocket, Kafka, DB, E2E",
  "scripts": {
    "aut:up": "docker compose -f docker/docker-compose.yml up -d --build --wait",
    "aut:down": "docker compose -f docker/docker-compose.yml down -v",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:ws": "playwright test --project=websocket",
    "test:kafka": "playwright test --project=messaging",
    "test:db": "playwright test --project=db",
    "test:e2e": "playwright test --project=e2e",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit && tsc --noEmit -p aut/tsconfig.json",
    "format": "prettier --write .",
    "test:regression": "playwright test --grep-invert \"@smoke|@slow\"",
    "test:contract": "playwright test --grep @contract",
    "test:security": "playwright test --grep @security|Token security|Input handling|HTTP hardening|Brute-force",
    "test:a11y": "playwright test --grep @a11y",
    "test:concurrency": "playwright test --grep @concurrency",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:perf": "playwright test --config=playwright.optin.config.ts --project=perf",
    "test:visual": "playwright test --config=playwright.optin.config.ts --project=visual",
    "test:visual:update": "playwright test --config=playwright.optin.config.ts --project=visual --update-snapshots",
    "test:chaos": "playwright test --config=playwright.optin.config.ts --project=chaos",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "gen:api-types": "openapi-typescript aut/openapi.json -o schemas/api.generated.ts",
    "gen:graphql-types": "graphql-codegen --config codegen.ts",
    "gen": "npm run gen:api-types && npm run gen:graphql-types",
    "prepare": "husky || true",
    "aut:up:ci": "docker compose -f docker/docker-compose.yml up -d --wait --no-build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.3.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@playwright/test": "^1.49.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "^16.4.7",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "graphql": "^17.0.2",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
