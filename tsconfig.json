{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@pages/*": ["pages/*"],
      "@components/*": ["components/*"],
      "@clients/*": ["clients/*"],
      "@services/*": ["services/*"],
      "@fixtures/*": ["fixtures/*"],
      "@utils/*": ["utils/*"],
      "@schemas": ["schemas/index.ts"],
      "@schemas/*": ["schemas/*"]
    }
  },
  "include": [
    "schemas",
    "config",
    "pages",
    "components",
    "clients",
    "services",
    "fixtures",
    "utils",
    "tests",
    "playwright.config.ts",
    "global-setup.ts"
  ],
  "exclude": ["aut", "node_modules"]
}
